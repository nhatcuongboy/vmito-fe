    "/sessions/find": "/browse/tournaments",
    "/tournaments": "/browse/tournaments",
    "/tournaments/new": "/host/tournaments/new"
  },
  "dynamicSegments": [
    {
      "name": "locale",
      "pattern": "[locale]",
      "description": "Language/locale (vi, en, cn)",
      "required": true,
      "always_in_url": true
    },
    {
      "name": "id",
      "pattern": "[id]",
      "description": "Resource ID (session or tournament)",
      "required": true,
      "examples": [
        "/sessions/123",
        "/host/sessions/456",
        "/browse/tournaments/789"
      ]
    },
    {
      "name": "playerId",
      "pattern": "[playerId]",
      "description": "Player identifier",
      "required": true,
      "examples": [
        "/player/user-123",
        "/browse/tournaments/456/players/user-789"
      ]
    },
    {
      "name": "categoryId",
      "pattern": "[categoryId]",
      "description": "Tournament category identifier",
      "required": true,
      "examples": ["/browse/tournaments/789/categories/men-doubles"]
    }
  ],
