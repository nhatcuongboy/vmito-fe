# Auth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# Apple "Services ID" used by Sign in with Apple JS (must also be added to
# APPLE_AUDIENCES on the backend)
NEXT_PUBLIC_APPLE_CLIENT_ID=""

# Environment: set to "staging" to disable SEO (noindex + disallow all bots)
# NEXT_PUBLIC_APP_ENV=staging

# Default locale for internationalization
NEXT_PUBLIC_DEFAULT_LOCALE="vi"

# API URL
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# E2E Testing
E2E_TEST_PASSWORD=

# Cloudinary Configuration
# For client-side components, we need cloud_name exposed
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# For server-side operations (optional, if needed)
CLOUDINARY_URL=

# Native app installation. A missing/invalid link disables that platform's popup.
NEXT_PUBLIC_IOS_APP_STORE_URL="https://apps.apple.com/us/app/vmito/id6811367135"
NEXT_PUBLIC_ANDROID_PLAY_STORE_URL=""
# Android uses Google Play above when configured; this direct APK URL is the fallback.
NEXT_PUBLIC_ANDROID_APK_URL="https://vmito.vn/downloads/vmito.apk"
NEXT_PUBLIC_ANDROID_APP_VERSION="1.0.0"
NEXT_PUBLIC_ANDROID_APK_SIZE="32 MB"
NEXT_PUBLIC_ANDROID_INSTALL_PROMPT_ENABLED="true"
NEXT_PUBLIC_ANDROID_RELEASE_NOTES="Cập nhật tính năng ghép kèo, thông báo thời gian thực và tối ưu hiệu năng."

# Days to wait before showing the install banner/popup again after "Lúc khác".
NEXT_PUBLIC_APP_INSTALL_DISMISS_COOLDOWN_DAYS="7"

# Universal Links (iOS) / App Links (Android) — lets a tap on the install
# CTA open the native app directly instead of the store, when it's already
# installed. Team ID/bundle ID/package name below are the real values from
# the vmito_app repo (ios/Runner.xcodeproj/project.pbxproj,
# android/app/build.gradle.kts). The feature degrades gracefully (falls
# back to today's store-link behavior) while ANDROID_SHA256_FINGERPRINTS is
# still empty. See docs/ENVIRONMENT_VARIABLES.md.
NEXT_PUBLIC_ANDROID_PACKAGE_NAME="com.vmito.app"
# Server-only (never sent to the browser): read at request time by the
# /.well-known route handlers, no Docker build ARG needed.
APPLE_TEAM_ID="NR2N74D46N"
IOS_BUNDLE_ID="com.vmito.app"
# Still a placeholder: this must be the Play App Signing certificate's
# SHA-256, which Google only generates after the first App Bundle upload
# in Play Console (App integrity -> App signing) — it is NOT the local
# upload/debug keystore's fingerprint. Comma-separate multiple values
# (e.g. debug + release) if needed for local testing.
ANDROID_SHA256_FINGERPRINTS=""
